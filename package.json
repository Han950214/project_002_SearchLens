{
  "name": "searchlens-cn",
  "version": "0.1.0",
  "description": "在百度网页搜索结果页本地提供可信度参考、推荐排序与偏好控制。",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "test": "esbuild tests/m2.3-verify.ts --bundle --packages=external --platform=node --format=esm --outfile=build/tests/m2.3-verify.mjs && node build/tests/m2.3-verify.mjs",
    "test:m3": "esbuild tests/m3.1-scoring.test.ts --bundle --packages=external --platform=node --format=esm --outfile=build/tests/m3.1-scoring.test.mjs && node build/tests/m3.1-scoring.test.mjs",
    "test:v0.4": "esbuild tests/v0.4-trust-ranking.test.ts --bundle --packages=external --platform=node --format=esm --outfile=build/tests/v0.4-trust-ranking.test.mjs && node build/tests/v0.4-trust-ranking.test.mjs",
    "test:v0.4-b": "esbuild tests/v0.4-b-entity-intent.test.ts --bundle --packages=external --platform=node --format=esm --outfile=build/tests/v0.4-b-entity-intent.test.mjs && node build/tests/v0.4-b-entity-intent.test.mjs",
    "test:v0.4-c": "esbuild tests/v0.4-c-baidu-runtime.test.ts --bundle --packages=external --platform=node --format=esm --loader:.css=text --outfile=build/tests/v0.4-c-baidu-runtime.test.mjs && node build/tests/v0.4-c-baidu-runtime.test.mjs",
    "test:extractor": "esbuild tests/extractor-stability.test.ts --bundle --packages=external --platform=node --format=esm --outfile=build/tests/extractor-stability.test.mjs && node build/tests/extractor-stability.test.mjs",
    "test:storage": "esbuild tests/storage-adapter.test.ts --bundle --packages=external --platform=node --format=esm --outfile=build/tests/storage-adapter.test.mjs && node build/tests/storage-adapter.test.mjs",
    "test:all": "npm test && npm run test:m3 && npm run test:v0.4 && npm run test:v0.4-b && npm run test:v0.4-c && npm run test:extractor && npm run test:storage",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "tsc --noEmit",
    "release:package-smoke": "node assets/release/source/verify-package-smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "esbuild": "^0.25.12",
    "linkedom": "^0.18.12",
    "typescript": "^5.9.3",
    "wxt": "^0.19.29"
  }
}
